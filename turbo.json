{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"globalEnv": ["NODE_ENV"],
	"globalPassThroughEnv": [
		"COMPOSE_PROJECT_NAME",
		"CRM_VERSION",
		"POSTGRES_USER",
		"POSTGRES_DB",
		"POSTGRES_PASSWORD",
		"CRM_DB_USER",
		"CRM_DB_PASSWORD",
		"REDIS_PASSWORD",
		"CRM_REDIS_MAXMEMORY",
		"CRM_NODE_IMAGE",
		"CRM_BUN_IMAGE",
		"CRM_POSTGRES_IMAGE",
		"CRM_REDIS_IMAGE",
		"CRM_POSTGRES_MEMORY_LIMIT",
		"CRM_POSTGRES_CPU_LIMIT",
		"CRM_REDIS_MEMORY_LIMIT",
		"CRM_REDIS_CPU_LIMIT",
		"CRM_API_MEMORY_LIMIT",
		"CRM_API_CPU_LIMIT",
		"CRM_APP_MEMORY_LIMIT",
		"CRM_APP_CPU_LIMIT",
		"CRM_CRON_MEMORY_LIMIT",
		"CRM_CRON_CPU_LIMIT",
		"CRM_MIGRATE_MEMORY_LIMIT",
		"CRM_MIGRATE_CPU_LIMIT",
		"CRM_AGENT_MEMORY_LIMIT",
		"CRM_AGENT_CPU_LIMIT",
		"DATABASE_URL",
		"DATABASE_POOL_MAX",
		"DATABASE_POOL_CONNECTION_TIMEOUT_MS",
		"DATABASE_POOL_IDLE_TIMEOUT_MS",
		"DATABASE_POOL_MAX_LIFETIME_SECONDS",
		"DATABASE_POOL_KEEPALIVE_INITIAL_DELAY_MS",
		"DATABASE_URL_UNPOOLED",
		"TEST_DATABASE_URL",
		"TEST_RUN_ID",
		"CRM_LOCAL_ACCESS_TEST",
		"CRM_BUSINESS_FLOW_TEST",
		"CRM_BUSINESS_SCHEMA_TEST",
		"CRM_BUSINESS_SCHEMA_NONCE",
		"DATABASE_POOL_TEST_ISOLATED",
		"BETTER_AUTH_SECRET",
		"BETTER_AUTH_URL",
		"ALLOWED_SIGN_IN",
		"GOOGLE_CLIENT_ID",
		"GOOGLE_CLIENT_SECRET",
		"MICROSOFT_CLIENT_ID",
		"MICROSOFT_CLIENT_SECRET",
		"SLACK_CLIENT_ID",
		"SLACK_CLIENT_SECRET",
		"MICROSOFT_TENANT_ID",
		"AUTH_COOKIE_DOMAIN",
		"CRON_SECRET",
		"REDIS_URL",
		"CACHE_TTL_MS",
		"PORT",
		"PRISMA_LOG_QUERIES",
		"PERPLEXITY_API_KEY",
		"GITHUB_TOKEN",
		"BLOB_READ_WRITE_TOKEN",
		"AI_GATEWAY_API_KEY",
		"VERCEL_OIDC_TOKEN",
		"AGENT_URL",
		"AGENT_BRIDGE_SECRET",
		"CRM_TELEMETRY_DISABLED",
		"CRM_TELEMETRY_ENABLED",
		"CRM_AI_ENABLED",
		"DO_NOT_TRACK",
		"VERCEL",
		"VERCEL_GIT_COMMIT_SHA"
	],

	"tasks": {
		"topo": {
			"dependsOn": ["^topo"]
		},
		"build": {
			"dependsOn": ["^build"],
			"env": ["API_URL", "APP_URL", "NEXT_PUBLIC_API_URL"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [
				".next/**",
				"!.next/cache/**",
				"!.next/dev/**",
				"dist/**",
				".output/**"
			]
		},
		"lint": {
			"dependsOn": ["topo"]
		},
		"check-types": {
			"dependsOn": ["topo", "^build"]
		},
		"test": {
			"dependsOn": ["topo", "^build"]
		},
		"dev": {
			"dependsOn": ["^dev:prepare"],
			"cache": false,
			"persistent": true
		},
		"dev:headless": {
			"dependsOn": ["^dev:prepare"],
			"cache": false,
			"persistent": true
		},
		"dev:prepare": {
			"cache": false
		}
	}
}
